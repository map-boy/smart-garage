import { useState, useEffect } from 'react';
import { Calculator, TrendingUp, TrendingDown, Landmark } from 'lucide-react';
import { Invoice } from '../../types';
import { formatCurrency } from '../../lib/utils';
import { useInvoices } from '../../hooks/useInvoices';

/**
 * VAT charged on the EBM invoice. It is collected on behalf of the revenue
 * authority and paid over, so it is never the garage's money and must come
 * off the top before any profit is worked out.
 */
const VAT_RATE = 0.18;

/**
 * What the garage actually kept on this vehicle.
 *
 *   amount charged  -  VAT  -  what the job cost  =  income
 *
 * The client's bill is issued through EBM; the owner types that figure in
 * here. Expenses come from the job itself: parts, paid labour, and free
 * services the garage absorbed. Treating the gross bill as income is the
 * mistake this panel exists to prevent - on a 100,000 invoice, 18,000 of it
 * was never the garage's to keep.
 */
export function InvoiceProfitCalculator({ invoice }: { invoice: Invoice }) {
  const { updateInvoice } = useInvoices();
  const [charged, setCharged] = useState<number | ''>(invoice.amountCharged ?? '');

  useEffect(() => { setCharged(invoice.amountCharged ?? ''); }, [invoice.id]);

  const partsCost = invoice.lineItems.filter(i => !i.isFree).reduce((a, i) => a + i.qty * i.unitCost, 0);
  const freeCost  = invoice.lineItems.filter(i => i.isFree).reduce((a, i) => a + i.qty * i.unitCost, 0);
  const expenses  = partsCost + invoice.laborCost + freeCost;

  const chargedNum = typeof charged === 'number' ? charged : 0;
  const vat = chargedNum * VAT_RATE;
  const netRevenue = chargedNum - vat;
  const profit = netRevenue - expenses;
  const margin = chargedNum > 0 ? (profit / chargedNum) * 100 : 0;
  const entered = charged !== '';

  const persist = () => {
    const value = typeof charged === 'number' ? charged : 0;
    if (value !== (invoice.amountCharged ?? 0)) updateInvoice({ ...invoice, amountCharged: value });
  };

  const Row = ({ label, value, tone = 'gray', bold = false }:
    { label: string; value: string; tone?: 'gray' | 'rose' | 'amber' | 'emerald'; bold?: boolean }) => (
    <div className={`flex justify-between ${bold ? 'font-bold' : ''} ${
      tone === 'rose' ? 'text-rose-600' : tone === 'amber' ? 'text-amber-700'
      : tone === 'emerald' ? 'text-emerald-700' : 'text-gray-600'}`}>
      <span>{label}</span><span>{value}</span>
    </div>
  );

  return (
    <div className="max-w-4xl mx-auto bg-white rounded-2xl border border-gray-200 shadow-sm p-6 space-y-5 mt-6">
      <div className="flex items-center gap-2">
        <Calculator className="w-4 h-4 text-blue-600" />
        <h3 className="text-xs font-black text-gray-900 uppercase tracking-wide">Profit on this vehicle</h3>
      </div>

      <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 print:hidden">
        <div className="space-y-1">
          <label className="text-xs font-bold text-gray-500 uppercase">Amount charged (EBM invoice)</label>
          <input
            type="number" min={0} step={100} placeholder="0"
            className="w-full p-3 rounded-xl border-2 border-blue-200 focus:border-blue-500 focus:ring-0 outline-none text-lg font-bold"
            value={charged}
            onChange={(e) => setCharged(e.target.value === '' ? '' : parseFloat(e.target.value))}
            onBlur={persist}
          />
        </div>
        <div className="space-y-1">
          <label className="text-xs font-bold text-gray-500 uppercase">Total spent on this vehicle</label>
          <div className="w-full p-3 rounded-xl bg-gray-50 border border-gray-200 text-lg font-bold text-gray-700">
            {formatCurrency(expenses)}
          </div>
        </div>
      </div>

      <div className="space-y-2 text-sm border-t border-gray-100 pt-4">
        <Row label="Amount charged to client" value={formatCurrency(chargedNum)} bold />
        <Row label={`VAT (${(VAT_RATE * 100).toFixed(0)}%) - paid to revenue authority`} value={'- ' + formatCurrency(vat)} tone="rose" />
        <div className="flex justify-between font-bold text-gray-800 border-t border-gray-100 pt-2">
          <span>Net revenue kept</span><span>{formatCurrency(netRevenue)}</span>
        </div>
      </div>

      <div className="space-y-2 text-sm border-t border-gray-100 pt-4">
        <Row label="Parts &amp; materials" value={'- ' + formatCurrency(partsCost)} />
        <Row label="Labour paid" value={'- ' + formatCurrency(invoice.laborCost)} />
        {freeCost > 0 && <Row label="Free services absorbed" value={'- ' + formatCurrency(freeCost)} tone="amber" />}
        <div className="flex justify-between font-bold text-gray-800 border-t border-gray-100 pt-2">
          <span>Total spent</span><span>{formatCurrency(expenses)}</span>
        </div>
      </div>

      <div className={`rounded-xl p-5 border-2 ${
        !entered ? 'bg-gray-50 border-gray-200'
        : profit > 0 ? 'bg-emerald-50 border-emerald-200'
        : profit < 0 ? 'bg-rose-50 border-rose-200' : 'bg-amber-50 border-amber-200'}`}>
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-2">
            {profit >= 0 ? <TrendingUp className="w-5 h-5 text-emerald-600" /> : <TrendingDown className="w-5 h-5 text-rose-600" />}
            <span className="text-xs font-black uppercase tracking-wide text-gray-700">
              {!entered ? 'Enter the amount charged' : profit >= 0 ? 'Income' : 'Loss'}
            </span>
          </div>
          <span className={`text-3xl font-black ${
            !entered ? 'text-gray-300' : profit > 0 ? 'text-emerald-700'
            : profit < 0 ? 'text-rose-700' : 'text-amber-700'}`}>
            {entered ? formatCurrency(profit) : '\u2014'}
          </span>
        </div>
        {entered && chargedNum > 0 && (
          <p className="text-xs font-bold mt-2 text-gray-500">
            {margin.toFixed(1)}% of what you charged &middot; after VAT and all costs
          </p>
        )}
        {entered && profit < 0 && (
          <p className="text-xs font-bold mt-2 text-rose-600">This job cost more than it brought in.</p>
        )}
      </div>

      <p className="flex items-start gap-1.5 text-[11px] text-gray-400">
        <Landmark className="w-3.5 h-3.5 shrink-0 mt-0.5" />
        VAT is taken at {(VAT_RATE * 100).toFixed(0)}% of the amount charged and is not income.
      </p>
    </div>
  );
}
